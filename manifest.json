{
  "manifest_version": 3,
  "name": "Wilco",
  "description": "Send the Wilco notetaker into Google Meet, track your follow-ups, and ask your company's meeting memory.",
  "version": "2.2.0",
  "version_name": "2.1.0",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "tabs",
    "notifications",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://sheets.googleapis.com/*",
    "http://localhost:8080/*",
    "http://localhost:3001/*",
    "https://34-58-54-115.sslip.io/*"
  ],
  "oauth2": {
    "client_id": "35439757502-0j977sdah63dqka6se7gli3oavk2kfu2.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3001/*",
        "https://34-58-54-115.sslip.io/*"
      ],
      "js": [
        "src/auth-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Wilco"
  },
  "omnibox": {
    "keyword": "mem"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open Wilco"
    }
  }
}
