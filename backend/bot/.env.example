# Copy to backend/bot/.env (never commit it).

# Same value as BOT_API_SECRET in backend/.env — generate with: openssl rand -hex 32
BOT_API_SECRET=

# From: python authorize_calendar.py <client_secret.json>   (signed in as the notetaker)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

NOTETAKER_EMAIL=notetaker@example.com
BOT_DISPLAY_NAME=Bhadra Notetaker
MEETING_LANGUAGE=hinglish
MAX_CONCURRENT_MEETINGS=2
