DATABASE_URL=postgresql+asyncpg://charcha:charchapass@localhost:5433/charcha
DATABASE_SSL=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_CACHE_DIR=.fastembed_cache

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Create this in the Gnani programme console. The default endpoint/model work
# with Prisma v3.0; override the URL only if Gnani issues your cohort one.
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_MODE=codemix
RECORDINGS_DIR=recordings

JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TEAM_ROSTER=
ADMIN_EMAILS=
ALLOWED_ORIGINS=http://localhost:3000

# --- Meeting Assistant ---
# "production" refuses FIXTURE_MODE outright.
APP_ENV=development
# Dev-only: labelled placeholder output when GNANI/GEMINI keys are missing.
FIXTURE_MODE=false
MAX_UPLOAD_BYTES=209715200
MAX_UPLOAD_DURATION_MINUTES=240
MAX_CONCURRENT_PROCESSING=2
EXTRACTION_CHUNK_CHARS=120000
CAPTURE_CLAIM_TIMEOUT_MINUTES=10
# Rates for the per-meeting *estimated* cost; 0 hides the estimate.
TRANSCRIPTION_USD_PER_MINUTE=0
AI_USD_PER_MILLION_INPUT_TOKENS=0
AI_USD_PER_MILLION_OUTPUT_TOKENS=0
