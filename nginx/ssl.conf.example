# HTTPS for a real domain. nginx only loads *.conf, so this file is inert
# until you (1) point DNS at the VM, (2) issue a certificate with certbot
# using the webroot /var/www/certbot, (3) replace charcha.example.com below
# with your domain, and (4) copy it to nginx/ssl.conf and restart nginx.
# Add a redirect to https in default.conf's "location /" once this works.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name charcha.example.com;

    ssl_certificate     /etc/letsencrypt/live/charcha.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/charcha.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 30s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    location = /health {
        proxy_pass http://backend:8080/health;
    }

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_request_buffering off;
        proxy_intercept_errors off;
        error_page 502 504 = @backend_restarting;
    }

    # The backend is down for a few seconds while a deploy restarts it: say
    # so (the web app retries reads on 503) instead of a bare 502 page.
    location @backend_restarting {
        default_type application/json;
        add_header Retry-After 5 always;
        return 503 '{"detail":"Charcha is restarting. Try again in a few seconds."}';
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
